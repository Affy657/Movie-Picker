{
  "openapi": "3.0.3",
  "info": {
    "title": "Movie Picker API",
    "description": "Référence migration .NET — aligné sur `apps/api` (Node). Erreurs : `{ \"error\": \"message\" }`. Token hôte : query `?host=` ou cookie `moviepicker_host`. Ordre routes ASP.NET : enregistrer `GET /events/slug/{id}` avant `GET /events/{id}` pour ne pas matcher \"slug\" comme id.",
    "version": "0.0.1-migration"
  },
  "servers": [{ "url": "http://localhost:4000", "description": "Développement" }],
  "paths": {
    "/health": {
      "get": {
        "summary": "Santé du service",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ok" },
                    "service": { "type": "string", "example": "movie-picker-api" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/movies/search": {
      "get": {
        "summary": "Recherche de films (TMDB)",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "Terme de recherche"
          }
        ],
        "responses": {
          "200": {
            "description": "Liste de résultats",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "integer" },
                      "title": { "type": "string" },
                      "year": { "type": "string" },
                      "posterPath": { "type": "string", "nullable": true }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "TMDB non configurée",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" },
                "example": { "error": "Recherche films temporairement indisponible" }
              }
            }
          }
        }
      }
    },
    "/events": {
      "post": {
        "summary": "Créer un event",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title", "date", "time"],
                "properties": {
                  "title": { "type": "string" },
                  "date": { "type": "string", "example": "2025-03-15" },
                  "time": { "type": "string", "example": "20:00" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Event créé (hostToken dans la réponse à conserver pour les actions hôte)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Document event Mongo + shareUrl. hostToken obligatoire pour le front (lien hôte).",
                  "properties": {
                    "_id": { "type": "string" },
                    "title": { "type": "string" },
                    "date": { "type": "string" },
                    "time": { "type": "string" },
                    "slug": { "type": "string" },
                    "hostToken": { "type": "string" },
                    "shareUrl": { "type": "string", "example": "/s/abc123xyz" },
                    "createdAt": { "type": "string", "format": "date-time" },
                    "updatedAt": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          },
          "400": { "description": "Validation échouée" }
        }
      }
    },
    "/events/slug/{idOrSlug}": {
      "get": {
        "summary": "Détail d'un event par slug",
        "parameters": [
          { "name": "idOrSlug", "in": "path", "required": true, "schema": { "type": "string" } },
          {
            "name": "host",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Token hôte pour isHost"
          }
        ],
        "responses": {
          "200": {
            "description": "Event avec isHost, terminé, winnerMovie",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EventDetail" }
              }
            }
          },
          "404": { "description": "Soirée introuvable" }
        }
      }
    },
    "/events/{idOrSlug}": {
      "get": {
        "summary": "Détail d'un event par id ou slug",
        "parameters": [
          { "name": "idOrSlug", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "host", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Event" },
          "404": { "description": "Soirée introuvable" }
        }
      }
    },
    "/events/{idOrSlug}/join": {
      "post": {
        "summary": "Rejoindre un event",
        "parameters": [
          { "name": "idOrSlug", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["pseudo"],
                "properties": {
                  "pseudo": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Participant créé",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Participant" } }
            }
          },
          "200": {
            "description": "Déjà inscrit",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "participant": { "$ref": "#/components/schemas/Participant" },
                    "message": { "type": "string", "example": "Déjà inscrit avec ce pseudo" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation Zod ou soirée terminée",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorBody" } } }
          },
          "404": {
            "description": "Soirée introuvable",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorBody" } } }
          }
        }
      }
    },
    "/events/{idOrSlug}/wheel": {
      "post": {
        "summary": "Lancer la roue (réservé à l'hôte)",
        "parameters": [
          { "name": "idOrSlug", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "host", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Film gagnant",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WheelResponse" }
              }
            }
          },
          "400": { "description": "Aucun film / roue déjà lancée / soirée clôturée" },
          "403": { "description": "Réservé à l'hôte" },
          "404": { "description": "Soirée introuvable" }
        }
      }
    },
    "/events/{idOrSlug}/close": {
      "post": {
        "summary": "Clôturer l'event (réservé à l'hôte)",
        "parameters": [
          { "name": "idOrSlug", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "host", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Soirée clôturée" },
          "403": { "description": "Réservé à l'hôte" },
          "404": { "description": "Soirée introuvable" }
        }
      }
    },
    "/events/{idOrSlug}/movies": {
      "get": {
        "summary": "Liste des films de l'event",
        "parameters": [
          { "name": "idOrSlug", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Liste des films avec proposerPseudo, score, up, down",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/MovieWithScore" }
                }
              }
            }
          },
          "404": { "description": "Soirée introuvable" }
        }
      },
      "post": {
        "summary": "Ajouter un film à l'event",
        "parameters": [
          { "name": "idOrSlug", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["tmdbId", "title", "year", "participantId"],
                "properties": {
                  "tmdbId": { "type": "integer" },
                  "title": { "type": "string" },
                  "year": { "type": "string" },
                  "posterPath": { "type": "string", "nullable": true },
                  "participantId": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Film ajouté" },
          "400": { "description": "Soirée terminée / participant invalide" },
          "409": { "description": "Déjà proposé (même TMDB ou titre)" },
          "404": { "description": "Soirée introuvable" }
        }
      }
    },
    "/events/{idOrSlug}/movies/{movieId}": {
      "delete": {
        "summary": "Supprimer un film (par le proposant, si roue non lancée)",
        "parameters": [
          { "name": "idOrSlug", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "movieId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["participantId"],
                "properties": {
                  "participantId": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "204": { "description": "Film supprimé" },
          "400": { "description": "Roue déjà lancée" },
          "403": { "description": "Seul le proposant peut retirer" },
          "404": { "description": "Film ou soirée introuvable" }
        }
      }
    },
    "/events/{idOrSlug}/movies/{movieId}/vote": {
      "post": {
        "summary": "Voter (upvote ou downvote)",
        "parameters": [
          { "name": "idOrSlug", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "movieId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["participantId", "value"],
                "properties": {
                  "participantId": { "type": "string" },
                  "value": { "type": "integer", "enum": [1, -1] }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Document vote (upsert)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Vote" } }
            }
          },
          "400": {
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorBody" } } }
          },
          "404": {
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorBody" } } }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorBody": {
        "type": "object",
        "required": ["error"],
        "properties": { "error": { "type": "string" } }
      },
      "Participant": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "eventId": { "type": "string" },
          "pseudo": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "Vote": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "eventId": { "type": "string" },
          "movieId": { "type": "string" },
          "participantId": { "type": "string" },
          "value": { "type": "integer", "enum": [1, -1] },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "EventDetail": {
        "type": "object",
        "description": "Event sans hostToken ; winnerMovie = film Mongo complet ou null",
        "properties": {
          "_id": { "type": "string" },
          "title": { "type": "string" },
          "date": { "type": "string" },
          "time": { "type": "string" },
          "slug": { "type": "string" },
          "config": { "type": "object", "additionalProperties": true },
          "closedAt": { "type": "string", "format": "date-time", "nullable": true },
          "winnerMovieId": { "type": "string", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "isHost": { "type": "boolean" },
          "terminé": { "type": "boolean" },
          "winnerMovie": { "nullable": true, "oneOf": [{ "type": "object" }, { "type": "null" }] }
        }
      },
      "MovieStored": {
        "type": "object",
        "description": "Film en base (réponse wheel / winnerMovie populate)",
        "properties": {
          "_id": { "type": "string" },
          "eventId": { "type": "string" },
          "participantId": { "type": "string" },
          "tmdbId": { "type": "integer" },
          "title": { "type": "string" },
          "year": { "type": "string" },
          "posterPath": { "type": "string", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "MovieWithScore": {
        "allOf": [
          { "$ref": "#/components/schemas/MovieStored" },
          {
            "type": "object",
            "properties": {
              "proposerPseudo": { "type": "string" },
              "score": { "type": "integer" },
              "up": { "type": "integer" },
              "down": { "type": "integer" }
            }
          }
        ]
      },
      "WheelResponse": {
        "type": "object",
        "properties": {
          "winner": { "$ref": "#/components/schemas/MovieStored" },
          "message": { "type": "string" }
        }
      }
    }
  }
}
