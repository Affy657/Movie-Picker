<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>opencover</Format>
          <Exclude>[MoviePicker.Api.TestSupport]*</Exclude>
          <ExcludeByFile>**/Program.cs,**/Contracts/**/*.cs,**/Configuration/**/*.cs,**/MoviePicker.Api.DevelopmentSeed/**/*.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
