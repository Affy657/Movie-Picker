<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>opencover</Format>
          <ExcludeByFile>**/Program.cs,**/Contracts/**/*.cs,**/Configuration/**/*.cs,**/Persistence/Mongo/Mongo*.cs,**/Persistence/Mongo/*Document.cs,**/Infrastructure/Posters/MongoPosterImageStore.cs,**/BackgroundServices/**/*.cs,**/Infrastructure/Development/**/*.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
