# Convention C# API .NET (dotnet format + analyzers, roadmap § 31)
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_size = 4
indent_style = space

# Style .NET (dotnet format)
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Naming / design : choix domaine volontaires (handlers, entité Event, tests xUnit avec _)
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1711.severity = none
dotnet_diagnostic.CA1716.severity = none

# LoggerMessage source-gen : hors périmètre MVP ; évite bruit CA1848/CA1873 sur middleware
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none

# Handlers CQRS / Clean Architecture : DI par constructeur avec de nombreuses
# dépendances est le pattern assumé de cette couche Application ; découper
# artificiellement n'améliorerait ni lisibilité ni testabilité.
dotnet_diagnostic.S107.severity = none

# Boucles avec effets de bord (écriture async conditionnelle) que l'analyseur
# confond avec une simple projection Select — le rewrite suggéré casserait le comportement.
dotnet_diagnostic.S3267.severity = none

# Code de seed Development (démo locale, déjà exclu de l'analyse SonarCloud) :
# identifiants de démo (pas des secrets prod) et littéraux répétés volontaires.
[**/Infrastructure/Development/*.cs]
dotnet_diagnostic.S1192.severity = none
dotnet_diagnostic.S2068.severity = none

# URL d'attribution TMDB et base URL email : chaînes fixes, pas des chemins filesystem.
[**/SearchMoviesHandler.cs]
dotnet_diagnostic.S1075.severity = none

[**/EmailServiceCollectionExtensions.cs]
dotnet_diagnostic.S1075.severity = none
