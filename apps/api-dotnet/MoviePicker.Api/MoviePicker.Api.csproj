<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <AssemblyName>MoviePicker.Api</AssemblyName>
    <InternalsVisibleTo>MoviePicker.Api.Tests</InternalsVisibleTo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MongoDB.Driver" Version="3.8.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" />
    <!--
      Pin de transitives héritées de MongoDB.Driver sur leurs dernières versions stables.
      - Snappier 1.3.1 : corrige GHSA-pggp-6c3x-2xmx (High) — fix amont disponible.
      - SharpCompress 0.40.0 : GHSA-6c8g-7p36-r338 (Moderate) toujours sans fix amont
        (MongoDB driver n'utilise pas l'API zip-slip à risque, cf. release note 3.8.1).
        Suppression NuGetAudit pour cet advisory dans ../Directory.Build.props.
    -->
    <PackageReference Include="Snappier" Version="1.3.1" />
    <PackageReference Include="SharpCompress" Version="0.40.0" />
  </ItemGroup>

</Project>
