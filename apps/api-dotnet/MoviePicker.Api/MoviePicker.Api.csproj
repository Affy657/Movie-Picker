<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <AssemblyName>MoviePicker.Api</AssemblyName>
    <InternalsVisibleTo>MoviePicker.Api.Tests</InternalsVisibleTo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MongoDB.Driver" Version="3.8.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" />
    <!--
      Pin de transitives héritées de MongoDB.Driver 3.7.1 sur leurs dernières versions
      stables. NB : les advisories liées à ces deux packages n'ont aucune version corrigée
      publiée à ce jour — la suppression NuGetAudit est gérée dans
      ../Directory.Build.props. Garder les overrides récents reste une bonne défense
      pour les autres patches non liés à ces advisories.
    -->
    <PackageReference Include="Snappier" Version="1.3.1" />
    <PackageReference Include="SharpCompress" Version="0.40.0" />
  </ItemGroup>

</Project>
