# URL de l'API (injectée au build). En dev, défaut http://localhost:4000
# Sans chemin /api/v1 : le client ajoute API_VERSION_PREFIX (/api/v1) aux routes métier.
# Si vous omettez le schéma (ex. localhost:4000), le client préfixe en http pour localhost/127.0.0.1,
# sinon en https — en prod utilisez toujours une URL complète avec https://.
# VITE_API_URL=http://localhost:4000

# Production (déploiement AWS) : pointer vers l'URL Cloud Run (racine du service, sans /api/v1)
# VITE_API_URL=https://votre-service.run.app
