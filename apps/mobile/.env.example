# URL de l'API .NET locale. Voir CONTEXT.md §9 pour les bonnes valeurs par plateforme.
# Émulateur Android :
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
# iOS simulator (laisser localhost) :
# EXPO_PUBLIC_API_URL=http://localhost:4000
# Device physique (IP LAN du poste de dev) :
# EXPO_PUBLIC_API_URL=http://192.168.1.42:4000

# Base TMDB pour les posters (web app + mobile).
EXPO_PUBLIC_TMDB_IMAGE_BASE=https://image.tmdb.org/t/p

# URL web publique utilisée pour générer le lien de partage event et les QR.
EXPO_PUBLIC_WEB_BASE_URL=http://localhost:5173
