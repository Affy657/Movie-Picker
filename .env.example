# Variables pour l’API .NET (local). Copier ce fichier en `.env` à la racine du repo
# (le fichier `.env` est ignoré par Git — ne jamais y commiter de secrets).
# Déploiement : README racine + .github/workflows/ci-cd.yml

# Obligatoire pour un run local avec MongoDB réel.
# IMPORTANT : en local, viser une base DÉDIÉE (ex. /moviepicker_dev), jamais la base de prod.
# Le seed de Development et les tests E2E écrivent dans cette base — elle doit être jetable.
# La prod utilise /moviepicker via GCP Secret Manager (MONGODB_URI), pas ce fichier.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/moviepicker_dev?...

# Recommandé (recherche de films TMDB)
# TMDB_API_KEY=votre_cle_tmdb
# Région pour les watch providers (défaut FR) — V1 §7
# TMDB_WATCH_REGION=FR
# Cache enrichissement TMDB en heures (défaut 24)
# TMDB_ENRICHMENT_CACHE_HOURS=24
# Limite d’enrichissements « où regarder » par requête de recherche (défaut 10)
# TMDB_SEARCH_MAX_PROVIDER_LOOKUPS=10
# Parallélisme enrichissement TMDB sur GET …/movies (défaut 4, max 16)
# TMDB_LIST_ENRICHMENT_MAX_PARALLEL=4
# Délai d'expiration des appels TMDB en secondes (défaut 3, max 30)
# TMDB_HTTP_TIMEOUT_SECONDS=3
# Durée de mise en cache d'un échec TMDB en minutes (défaut 5, max 60)
# TMDB_FAILURE_CACHE_MINUTES=5

# --- Rappels de soirée
# Jeton attendu dans l'en-tête X-Scheduler-Token sur POST /api/v1/scheduler/event-reminders.
# Sans ce jeton l'endpoint répond 503 : en production il est fourni par Cloud Scheduler.
# SCHEDULER_TOKEN=un_secret_long_et_aleatoire
# Rejoue les rappels dans le processus (boucle 30 min). Actif d'office en Development.
# Ne jamais activer sur Cloud Run : le CPU y est étranglé hors requête et le service
# descend à zéro instance, donc la boucle ne s'exécute pas de façon fiable.
# IN_PROCESS_REMINDERS_ENABLED=0

# Optionnel en local : en Development, localhost est autorisé sans cette variable.
# Requis en Production / Docker : origines du front, séparées par des virgules, sans slash final.
# ALLOWED_ORIGINS=https://d1234567890.cloudfront.net
#
# Avec domaine custom + apex en redirection (§ 36) :
# inclure web., l’apex et www si des clients peuvent encore appeler l’API depuis ces origines.
# Si un sous-domaine sert une SPA qui appelle l’API (ex. OG / prerender avec JS), l’ajouter aussi.
# ALLOWED_ORIGINS=https://web.movie-picker.fr,https://movie-picker.fr,https://www.movie-picker.fr

# Open Graph / share-preview : URL canonique du front (HTTPS, sans slash final)
# PUBLIC_WEB_BASE_URL=https://web.movie-picker.fr

# Cache affiches (Mongo ou mémoire — pas de bucket séparé requis)
# POSTER_CACHE_ENABLED=true
# POSTER_CACHE_TTL_DAYS=30
# POSTER_CACHE_MAX_BYTES=524288

# Compte de test en local (Development) : défaut dans appsettings.Development.json → DevelopmentSeed.
# Désactiver : DevelopmentSeed__Enabled=false
# Personnaliser : DevelopmentSeed__Email=..., DevelopmentSeed__Password=..., DevelopmentSeed__DisplayName=...
# Soirées de test pour le compte dev (défaut true) : DevelopmentSeed__SeedSampleEvents=false
# Scénarios démo multi-utilisateurs (Alice/Bob/Carla/David, films, votes, « déjà vu », roue) : DevelopmentSeed__SeedScenarioDemos=false

# --- V1 auth (cookie + session MongoDB)
# Anneau de clés Data Protection (XML), pour que les cookies de session restent valides entre redémarrages / instances.
# En prod : Secret Manager AUTH_DATAPROTECTION_KEYRING.
# AUTH_DATAPROTECTION_KEYRING_FILE=C:/chemin/vers/keyring.xml
# ou, selon l’implémentation retenue dans Program.cs, variable pointant vers le répertoire / le XML.

# --- V1 emails transactionnels (mot de passe oublié)
# Fournisseur : "log" (défaut, dev/local : email loggué dans la console) ou "resend" (prod via API Resend).
# EMAIL_PROVIDER=log
# Adresse expéditeur. Domaine doit être vérifié dans Resend (movie-picker.fr).
# EMAIL_FROM_ADDRESS=noreply@movie-picker.fr
# Nom affiché de l'expéditeur (apparaît dans la boîte de réception).
# EMAIL_FROM_NAME=Movie Picker
# Clé API Resend (re_...). Obligatoire si EMAIL_PROVIDER=resend.
# En prod : Secret Manager RESEND_API_KEY.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxx
# URL base Resend (rarement à changer ; utile pour tests E2E avec mock).
# RESEND_API_BASE_URL=https://api.resend.com

# --- V1.4 connexion sociale (OAuth Google / GitHub) — voir docs/roadmap-product.md
# Provider absent des variables ci-dessous = provider masqué (pas d'erreur, juste pas de bouton).
# Callback à enregistrer côté provider : http://localhost:4000/signin-google (Google)
# et http://localhost:4000/signin-github (GitHub) en local.
# En prod : Secret Manager OAUTH_GOOGLE_CLIENT_ID / OAUTH_GOOGLE_CLIENT_SECRET / OAUTH_GITHUB_CLIENT_ID / OAUTH_GITHUB_CLIENT_SECRET.
# OAUTH_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# OAUTH_GOOGLE_CLIENT_SECRET=GOCSPX-xxxxx
# OAUTH_GITHUB_CLIENT_ID=xxxxx
# OAUTH_GITHUB_CLIENT_SECRET=xxxxx

# --- Suggestions d’idées (création d’issues GitHub)
# Requis en local pour que « Proposer une idée » fonctionne (sinon l’API répond 503).
# En prod : Secret Manager GITHUB_TOKEN, PAT fine-grained avec Issues: write uniquement.
# GITHUB_TOKEN=github_pat_xxxxx
# GITHUB_REPO_OWNER=Affy657
# GITHUB_REPO_NAME=Movie-Picker

# --- V1.1 notifications push (VAPID) — voir docs/roadmap-product.md
# Générer une seule fois avec : node -e "const {webcrypto}=require('crypto');(async()=>{const k=await webcrypto.subtle.generateKey({name:'ECDH',namedCurve:'P-256'},true,['deriveKey']);const pub=await webcrypto.subtle.exportKey('raw',k.publicKey);const priv=await webcrypto.subtle.exportKey('jwk',k.privateKey);console.log('PUBLIC='+Buffer.from(pub).toString('base64url'));console.log('PRIVATE='+priv.d);})()"
# En prod : stocker dans Secret Manager et référencer depuis Cloud Run.
# VAPID_PUBLIC_KEY=BEpEbt...
# VAPID_PRIVATE_KEY=dm4jt...
# VAPID_SUBJECT=mailto:noreply@movie-picker.fr
