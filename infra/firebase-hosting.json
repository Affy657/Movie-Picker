{
  "cleanUrls": false,
  "trailingSlashBehavior": "REMOVE",
  "rewrites": [
    { "glob": "/r/**", "run": { "serviceId": "movie-picker-api", "region": "europe-west1" } },
    { "glob": "/e/*", "run": { "serviceId": "movie-picker-api", "region": "europe-west1" } },
    { "glob": "/film/*", "run": { "serviceId": "movie-picker-api", "region": "europe-west1" } },
    { "glob": "/serie/*", "run": { "serviceId": "movie-picker-api", "region": "europe-west1" } },
    { "glob": "/u/*", "run": { "serviceId": "movie-picker-api", "region": "europe-west1" } },
    { "glob": "/l/**", "path": "/invitations/list.html" },
    { "glob": "/g/**", "path": "/invitations/group.html" },
    {
      "glob": "/@(decouvrir|new|login|register|forgot-password|reset|verify-email|mentions-legales|politique-de-confidentialite|soutenir|tech|nouveautes|statut|my-events|watchlist|listes|groupes|notifications)",
      "path": "/index.html"
    },
    { "glob": "/auth/callback", "path": "/index.html" },
    { "glob": "/settings", "path": "/index.html" },
    { "glob": "/settings/**", "path": "/index.html" },
    {
      "glob": "/films/@(recherche|collections|tendances|au-cinema|les-plus-proposes)",
      "path": "/index.html"
    },
    { "glob": "/films/@(similaires|streaming|theme|collection)/*", "path": "/index.html" },
    { "glob": "/listes/*", "path": "/index.html" },
    { "glob": "/listes/enregistrees/*", "path": "/index.html" },
    { "glob": "/groupes/*", "path": "/index.html" },
    {
      "glob": "/u/*/@(films|propositions|propositions-gagnantes|watchlist|listes)",
      "path": "/index.html"
    },
    { "glob": "/u/*/listes/*", "path": "/index.html" }
  ],
  "headers": [
    {
      "glob": "**",
      "headers": {
        "Cache-Control": "no-cache, must-revalidate",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Content-Security-Policy": "frame-ancestors 'none'",
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Resource-Policy": "same-site",
        "X-Content-Type-Options": "nosniff",
        "Strict-Transport-Security": "max-age=31536000; includeSubDomains; preload",
        "Permissions-Policy": "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
      }
    },
    {
      "glob": "/assets/**",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "glob": "/@(favicon.svg|favicon.ico|logo.svg|og-image.png)",
      "headers": {
        "Cache-Control": "public, max-age=86400, must-revalidate",
        "Cross-Origin-Resource-Policy": "cross-origin"
      }
    },
    {
      "glob": "/icons/**",
      "headers": {
        "Cache-Control": "public, max-age=86400, must-revalidate",
        "Cross-Origin-Resource-Policy": "cross-origin"
      }
    },
    {
      "glob": "/@(robots.txt|sitemap.xml|llms.txt)",
      "headers": { "Cache-Control": "public, max-age=3600, must-revalidate" }
    },
    {
      "glob": "/.well-known/security.txt",
      "headers": { "Cache-Control": "public, max-age=3600, must-revalidate" }
    },
    {
      "glob": "/sw.js",
      "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" }
    }
  ]
}
