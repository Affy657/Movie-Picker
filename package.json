{
  "name": "movie-picker",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:api-dotnet": "dotnet run --project apps/api-dotnet/MoviePicker.Api/MoviePicker.Api.csproj",
    "lint": "turbo run lint",
    "lint:eslint": "eslint \"apps/web/src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"apps/**/*.{ts,tsx,json}\" \"configs/**/*.{json,md,cjs}\" \"e2e/**/*.ts\" playwright.config.ts",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,json}\" \"configs/**/*.{json,md,cjs}\" \"e2e/**/*.ts\" playwright.config.ts",
    "format:dotnet": "dotnet format apps/api-dotnet/MoviePicker.slnx --verbosity minimal",
    "format:dotnet:check": "dotnet format apps/api-dotnet/MoviePicker.slnx --verify-no-changes --verbosity minimal",
    "openapi:export": "node scripts/export-openapi.cjs",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "playwright test",
    "test:e2e:ci": "cross-env VITE_API_URL=http://127.0.0.1:5010 pnpm --filter \"./apps/web\" run build && cross-env CI=1 pnpm run test:e2e",
    "audit": "pnpm audit --audit-level=high",
    "verify:local": "node scripts/verify-local.cjs",
    "lighthouse": "node scripts/lighthouse-run.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "chrome-launcher": "^1.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "lighthouse": "^13.0.3",
    "prettier": "^3.8.1",
    "serve": "^14.2.6",
    "turbo": "^2.9.3"
  },
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20"
  }
}
