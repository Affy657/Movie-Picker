{
  "name": "movie-picker",
  "private": true,
  "simple-git-hooks": {
    "pre-push": "pnpm run lint && pnpm run format:check && node scripts/sonar-local.cjs"
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:web:log": "turbo run dev --filter=web > logs/web.log 2>&1",
    "dev:api-dotnet": "dotnet run --project apps/api-dotnet/MoviePicker.Api/MoviePicker.Api.csproj",
    "dev:api-dotnet:log": "dotnet run --project apps/api-dotnet/MoviePicker.Api/MoviePicker.Api.csproj > logs/api.log 2>&1",
    "lint": "turbo run lint",
    "lint:eslint": "eslint \"apps/web/src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"apps/**/*.{ts,tsx,json}\" \"configs/**/*.{json,md,cjs}\" \"e2e/**/*.ts\" playwright.config.ts eslint.config.mjs",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,json}\" \"configs/**/*.{json,md,cjs}\" \"e2e/**/*.ts\" playwright.config.ts eslint.config.mjs",
    "format:dotnet": "dotnet format apps/api-dotnet/MoviePicker.slnx --verbosity minimal",
    "format:dotnet:check": "dotnet format apps/api-dotnet/MoviePicker.slnx --verify-no-changes --verbosity minimal",
    "openapi:export": "node scripts/export-openapi.cjs",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "playwright test",
    "test:e2e:ci": "cross-env VITE_API_URL=http://127.0.0.1:5010 pnpm --filter \"./apps/web\" run build && cross-env CI=1 pnpm run test:e2e",
    "audit": "pnpm audit --audit-level=high",
    "check:sonar": "sonar-scanner",
    "verify:local": "node scripts/verify-local.cjs",
    "lighthouse": "node scripts/lighthouse-run.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "chrome-launcher": "^1.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "lighthouse": "^13.3.0",
    "prettier": "^3.8.4",
    "serve": "^14.2.6",
    "simple-git-hooks": "^2.13.1",
    "turbo": "^2.9.16",
    "typescript-eslint": "^8.61.0"
  },
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "pnpm": {
    "overrides": {
      "basic-ftp": ">=5.3.1",
      "picomatch": ">=4.0.4",
      "lodash-es": ">=4.18.0",
      "postcss": ">=8.5.10",
      "fast-uri": ">=3.1.2",
      "@types/react": "^19.2.0",
      "@types/react-dom": "^19.2.0",
      "@tootallnate/once@<3.0.1": ">=3.0.1",
      "ip-address@<=10.1.0": ">=10.1.1",
      "brace-expansion@>=5.0.0 <5.0.6": ">=5.0.6",
      "ws": ">=8.21.0",
      "esbuild@>=0.17.0 <0.28.1": ">=0.28.1",
      "shell-quote@>=1.1.0 <=1.8.3": ">=1.8.4",
      "uuid@<11.1.1": ">=11.1.1",
      "undici@>=7.23.0 <7.28.0": "^7.28.0"
    }
  }
}
