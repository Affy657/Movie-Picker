{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "configs/tsconfig.base.json",
    "configs/tsconfig.node.json",
    "eslint.config.mjs",
    "prettier.config.cjs"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
