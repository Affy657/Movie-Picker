{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "web", "dev"],
      "port": 5173
    },
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "apps/api-dotnet/MoviePicker.Api/MoviePicker.Api.csproj"
      ],
      "port": 4000
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "mobile", "run", "web", "--port", "8081"],
      "port": 8081
    },
    {
      "name": "slides",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "docs/RNCP/bloc-1-cadrage/slides", "run", "dev"],
      "port": 3030
    }
  ]
}
